{
  "id": "falcon-vault",
  "name": "Falcon Vault",
  "description": "Your password manager inside OpenClaw, and where config credentials come from.",
  "version": "5.0.0-dev.0",
  "categories": [
    "security"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "activation": {
    "onStartup": true
  },
  "secretProviderIntegrations": {
    "falcon-vault": {
      "displayName": "Falcon Vault",
      "description": "Entries in the Falcon Vault KeePassXC database. Reference an entry by its path, or path:Field.",
      "source": "exec",
      "command": "${node}",
      "args": [
        "./bin/resolve-secrets.mjs"
      ],
      "passEnv": [
        "OPENCLAW_STATE_DIR"
      ],
      "jsonOnly": true
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/17d5e0312f211f1dff2e17f4b28510ca96b1a621f8355f797b7e8826bbe7ea3b/index.js",
    "styles": [
      "dist/control-ui/17d5e0312f211f1dff2e17f4b28510ca96b1a621f8355f797b7e8826bbe7ea3b/index.css"
    ]
  },
  "contracts": {
    "tools": [
      "falcon_vault"
    ]
  }
}
