{
  "id": "falcon-vault",
  "name": "Falcon Vault",
  "description": "Credentials for your agents and OpenClaw, stored in your KeePassXC database.",
  "version": "5.0.0-dev.0",
  "categories": [
    "security"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "activation": {
    "onStartup": true
  },
  "secretProviderIntegrations": {
    "falcon-vault": {
      "displayName": "Falcon Vault",
      "description": "Entries in the Falcon Vault KeePassXC database. Reference an entry by its path, or path:Field.",
      "source": "exec",
      "command": "${node}",
      "args": [
        "./bin/resolve-secrets.mjs"
      ],
      "passEnv": [
        "OPENCLAW_STATE_DIR"
      ],
      "jsonOnly": true
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/70f27ba4e8a2ea0b67d451534074f5b290260e5ad0d860ab00afb63813a50093/index.js",
    "styles": [
      "dist/control-ui/70f27ba4e8a2ea0b67d451534074f5b290260e5ad0d860ab00afb63813a50093/index.css"
    ]
  },
  "contracts": {
    "tools": [
      "falcon_vault"
    ]
  }
}
