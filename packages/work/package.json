{
  "name": "@fdsouvenir/falcon-work",
  "version": "5.0.0-dev.0",
  "description": "Falcon Work for OpenClaw: a record of what your agents do, why, and what needs you.",
  "type": "module",
  "license": "CC-BY-NC-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fdsouvenir/falcon-suite",
    "directory": "packages/work"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && OPENCLAW_STATE_DIR=../../.openclaw-build openclaw plugins build",
    "validate": "OPENCLAW_STATE_DIR=../../.openclaw-build openclaw plugins validate --json",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "files": [
    "dist",
    "assets",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.6"
  },
  "dependencies": {
    "typebox": "^1.3.17"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "openclaw": "2026.9.6",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.6"
    }
  }
}
